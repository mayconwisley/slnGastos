<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#4EA3E3</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101A24" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#172737" />
    <SolidColorBrush x:Key="AlternateSurfaceBrush" Color="#1D3347" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E7F1FA" />
    <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#EAF4FF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#09263F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B4D67" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#24435C" />
    <SolidColorBrush x:Key="PositiveBrush" Color="#4DD18B" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#FF7D71" />
</ResourceDictionary>
