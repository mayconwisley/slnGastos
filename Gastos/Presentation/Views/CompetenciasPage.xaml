<UserControl x:Class="Gastos.Presentation.Views.CompetenciasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cliente" />
                    <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Competência" />
                    <TextBox Text="{Binding MesReferencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="Competência ativa" IsChecked="{Binding Ativa}" />
                    <TextBlock Text="{Binding Status}" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Content="Novo" Command="{Binding LimparCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,0" />
                    <Button Content="Excluir" Command="{Binding ExcluirCommand}" Background="{DynamicResource NegativeBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Competencias}" SelectedItem="{Binding CompetenciaSelecionada}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Competência" Binding="{Binding MesReferencia, StringFormat={}{0:MM/yyyy}}" Width="*" />
                    <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativa}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
