<UserControl x:Class="Gastos.Presentation.Views.ConsultaMovimentacoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:Gastos.Presentation.Controles">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Cliente" /><ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><TextBlock Text="{Binding CompetenciaAtual, StringFormat=Competência ativa: {0}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
                <Button Grid.Column="2" Content="Atualizar lista" Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <controles:DataGridArredondado ItemsSource="{Binding Itens}" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataMovimento, StringFormat={}{0:dd/MM/yyyy}}" Width="105" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="120" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoLancamento}" Width="100" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="110" />
                    <DataGridTextColumn Header="Origem" Binding="{Binding Integrado}" Width="150" />
                </DataGrid.Columns>
            </controles:DataGridArredondado>
        </Border>
    </Grid>
</UserControl>
