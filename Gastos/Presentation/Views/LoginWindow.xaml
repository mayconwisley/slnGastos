<Window x:Class="Gastos.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Gastos.Presentation.Controles"
        Title="Finora — Controle de Gastos"
        Width="860"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Margin="24"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SidebarBrush}" CornerRadius="17,0,0,17">
                    <StackPanel Margin="52" VerticalAlignment="Center">
                        <controles:MarcaFinora Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="Seu controle financeiro, com clareza." Margin="0,28,0,12" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource NavigationForegroundBrush}" />
                        <TextBlock Text="Organize sua vida financeira com clareza, em um único lugar." Foreground="{DynamicResource NavigationForegroundBrush}" Opacity="0.8" FontSize="15" TextWrapping="Wrap" LineHeight="23" />
                    </StackPanel>
                </Border>
                <Grid Grid.Column="1" Margin="56,42">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bem-vindo de volta" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Entre para acessar seus controles financeiros." Margin="0,8,0,30" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="14" />
                        <TextBlock Text="Usuário" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,18" />
                        <TextBlock Text="Senha" FontWeight="SemiBold" />
                        <PasswordBox x:Name="SenhaLogin" PasswordChanged="SenhaLoginAlterada" Margin="0,8,0,22" />
                        <Button Command="{Binding EntrarCommand}" Content="Entrar" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LembrarSenhaCommand}" Content="Esqueci minha senha" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Status}" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
