<Window x:Class="Gastos.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle de Gastos" Width="450" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="42">
        <StackPanel>
            <TextBlock Text="Controle de gastos" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Acesse sua conta" Margin="0,6,0,28" Opacity="0.75" />
            <TextBlock Text="Usuário" />
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
            <TextBlock Text="Senha" />
            <PasswordBox x:Name="SenhaLogin" PasswordChanged="SenhaLoginAlterada" Margin="0,6,0,14" />
            <Button Command="{Binding EntrarCommand}" Content="Entrar" />
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding LembrarSenhaCommand}" Content="Esqueci minha senha" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
