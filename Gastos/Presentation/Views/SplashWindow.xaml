<Window x:Class="Gastos.Presentation.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:Gastos.Presentation.Controles"
        Title="Finora"
        Width="520"
        Height="330"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            SnapsToDevicePixels="True">
        <Grid Margin="44,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controles:MarcaFinora Width="215" HorizontalAlignment="Left" />

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,30,0,26">
                <TextBlock Text="Preparando seu ambiente"
                           FontSize="23"
                           FontWeight="SemiBold" />
                <TextBlock Text="Estamos deixando tudo pronto para você controlar suas finanças."
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <Path Data="M 12,2 A 10,10 0 1 1 4.93,4.93"
                          Stroke="{DynamicResource PrimaryBrush}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <RotateTransform CenterX="12" CenterY="12" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusTextBlock"
                               FontWeight="SemiBold"
                               Text="Iniciando aplicação..." />
                    <TextBlock Text="Isso pode levar alguns instantes na primeira execução."
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
