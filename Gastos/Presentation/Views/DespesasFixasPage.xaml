<UserControl x:Class="Gastos.Presentation.Views.DespesasFixasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:Gastos.Presentation.Controles">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cliente" />
                    <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Descrição" />
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Valor" />
                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Data inicial" />
                    <TextBox Text="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Novo" Command="{Binding LimparCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,0" />
                    <Button Content="Excluir" Command="{Binding ExcluirCommand}" Background="{DynamicResource NegativeBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Data final (opcional)" />
                    <TextBox Text="{Binding DataFim, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total ativo" Opacity="0.7" /><TextBlock Text="{Binding TotalAtivo, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Total inativo" Opacity="0.7" /><TextBlock Text="{Binding TotalInativo, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Total geral" Opacity="0.7" /><TextBlock Text="{Binding TotalGeral, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <controles:DataGridArredondado ItemsSource="{Binding Despesas}" SelectedItem="{Binding DespesaSelecionada}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="120" />
                        <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                        <DataGridTextColumn Header="Fim" Binding="{Binding DataFim, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                        <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativa}" Width="80" />
                    </DataGrid.Columns>
                </controles:DataGridArredondado>
            </Border>
        </Grid>
    </Grid>
</UserControl>
