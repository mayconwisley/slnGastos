<Window x:Class="Gastos.Presentation.Views.CadastroInicialUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primeiro usuário · Controle de Gastos"
        Width="600"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Border Style="{StaticResource Card}" Padding="48">
            <StackPanel>
                <Border Width="44" Height="44" Background="{DynamicResource PrimaryBrush}" CornerRadius="14" HorizontalAlignment="Left">
                    <TextBlock Text="+" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <TextBlock Text="Crie seu primeiro acesso" Margin="0,22,0,8" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Este usuário administrará os cadastros e as informações da aplicação." Margin="0,0,0,28" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Login" FontWeight="SemiBold" />
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,16" />
                <TextBlock Text="Nome" FontWeight="SemiBold" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Senha" FontWeight="SemiBold" />
                        <PasswordBox PasswordChanged="SenhaAlterada" Margin="0,8,0,16" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirme a senha" FontWeight="SemiBold" />
                        <PasswordBox PasswordChanged="ConfirmacaoSenhaAlterada" Margin="0,8,0,16" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Lembrete de senha" FontWeight="SemiBold" />
                <TextBox Text="{Binding Lembrete, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,24" />
                <Button Content="Criar usuário" Command="{Binding CriarUsuarioCommand}" />
                <TextBlock Text="{Binding Status}" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
