<UserControl x:Class="Gastos.Presentation.Views.MovimentacoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cliente" />
                    <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Descrição" />
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Valor" />
                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Data" />
                    <TextBox Text="{Binding DataMovimento, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Novo" Command="{Binding LimparCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,0" />
                    <Button Content="Excluir" Command="{Binding ExcluirCommand}" Background="{DynamicResource NegativeBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tipo" />
                    <ComboBox ItemsSource="{Binding TiposLancamento}" SelectedItem="{Binding TipoLancamento}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Meio monetário" />
                    <ComboBox ItemsSource="{Binding MeiosMonetarios}" SelectedItem="{Binding MeioMonetario}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Situação" />
                    <ComboBox ItemsSource="{Binding Situacoes}" SelectedItem="{Binding Situacao}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompetenciaAtual, StringFormat=Competência ativa: {0}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="4" Content="Atualizar lista" Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Movimentacoes}" SelectedItem="{Binding MovimentacaoSelecionada}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataMovimento, StringFormat={}{0:dd/MM/yyyy}}" Width="105" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="120" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoLancamento}" Width="100" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="110" />
                    <DataGridTextColumn Header="Origem" Binding="{Binding Integrado}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
