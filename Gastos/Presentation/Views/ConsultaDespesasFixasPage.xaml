<UserControl x:Class="Gastos.Presentation.Views.ConsultaDespesasFixasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:Gastos.Presentation.Controles">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Cliente" /><ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Bottom" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Atualizar lista" Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <UniformGrid Grid.Row="2" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total ativo" Opacity="0.7" /><TextBlock Text="{Binding TotalAtivo, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Total inativo" Opacity="0.7" /><TextBlock Text="{Binding TotalInativo, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Total geral" Opacity="0.7" /><TextBlock Text="{Binding TotalGeral, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <controles:DataGridArredondado ItemsSource="{Binding Itens}" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="120" />
                    <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    <DataGridTextColumn Header="Fim" Binding="{Binding DataFim, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativa}" Width="80" />
                </DataGrid.Columns>
            </controles:DataGridArredondado>
        </Border>
    </Grid>
</UserControl>
