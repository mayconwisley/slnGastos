<Window x:Class="Gastos.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:servicos="clr-namespace:Gastos.Presentation.Servicos"
        xmlns:vm="clr-namespace:Gastos.Presentation.ViewModels"
        xmlns:views="clr-namespace:Gastos.Presentation.Views"
        Title="Controle de Gastos" Height="760" Width="1280" MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PainelViewModel}"><views:PainelPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}"><views:ClientesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompetenciasViewModel}"><views:CompetenciasPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsuariosViewModel}"><views:UsuariosPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DespesasFixasViewModel}"><views:DespesasFixasPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovimentacoesViewModel}"><views:MovimentacoesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmprestimosViewModel}"><views:EmprestimosPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevedoresViewModel}"><views:DevedoresPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParcelasEmprestimoViewModel}"><views:ParcelasEmprestimoPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParcelasDevedorViewModel}"><views:ParcelasDevedorPage /></DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <Binding />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock Text="CONTROLE" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NavigationForegroundBrush}" />
                    <TextBlock Text="DE GASTOS" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NavigationForegroundBrush}" />
                    <Border Height="1" Margin="0,18,0,0" Background="#5A9ED1" Opacity="0.45" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,8,12">
                        <Button Style="{StaticResource NavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.Painel}">⌂  Painel</Button>
                        <Expander Header="Cadastros" IsExpanded="True">
                            <StackPanel>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.Clientes}">Clientes</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.Competencias}">Competências</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.Usuarios}">Usuários</Button>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Despesas fixas">
                            <StackPanel>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.DespesasFixasCadastro}">Cadastro</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.DespesasFixasConsulta}">Consulta</Button>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Empréstimos">
                            <StackPanel>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.EmprestimosCadastro}">Cadastro</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.EmprestimosMovimentacao}">Movimentação</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.EmprestimosConsulta}">Consulta</Button>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Devedores">
                            <StackPanel>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.DevedoresCadastro}">Cadastro</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.DevedoresMovimentacao}">Movimentação</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.DevedoresConsulta}">Consulta</Button>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Movimentações">
                            <StackPanel>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.MovimentacoesCadastro}">Cadastro</Button>
                                <Button Style="{StaticResource SubNavigationButton}" Command="{Binding NavegarCommand}" CommandParameter="{x:Static servicos:RotaPagina.MovimentacoesConsulta}">Consulta</Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,16">
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding AlternarTemaCommand}">
                        <TextBlock><Run Text="◐  " /><Run Text="{Binding TextoTema, Mode=OneWay}" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding SairCommand}">↪  Sair</Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloPagina}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Usuario, StringFormat=Usuário: {0}}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding PaginaAtual}" Margin="32,26" />
        </Grid>
    </Grid>
</Window>
