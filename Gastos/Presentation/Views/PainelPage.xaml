<UserControl x:Class="Gastos.Presentation.Views.PainelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cliente" />
                        <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,16,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Competência" />
                        <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,16,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Atualizar" Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Status}" Margin="0,14,0,0" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" />
            <UniformGrid Columns="2" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,9,9"><StackPanel><TextBlock Text="DESPESAS FIXAS" Opacity="0.7" /><TextBlock Text="{Binding DespesasFixas}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="9,0,0,9"><StackPanel><TextBlock Text="EMPRÉSTIMOS EM ABERTO" Opacity="0.7" /><TextBlock Text="{Binding Emprestimos}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,9,9,0"><StackPanel><TextBlock Text="DÉBITOS DE DEVEDORES" Opacity="0.7" /><TextBlock Text="{Binding DebitosDevedores}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="9,9,0,0"><StackPanel><TextBlock Text="CRÉDITOS DE DEVEDORES" Opacity="0.7" /><TextBlock Text="{Binding CreditosDevedores}" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="SALDO DO MÊS" Opacity="0.7" />
                    <TextBlock Text="{Binding Saldo}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
