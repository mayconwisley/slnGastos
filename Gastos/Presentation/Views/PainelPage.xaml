<UserControl x:Class="Gastos.Presentation.Views.PainelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="164" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Cliente" Foreground="{DynamicResource MutedForegroundBrush}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Competência" Foreground="{DynamicResource MutedForegroundBrush}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Competencia, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Atualizar dados" Command="{Binding AtualizarCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Status}" Margin="2,14,0,0" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" />
            <TextBlock Text="RESUMO FINANCEIRO" Margin="2,24,0,12" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
            <UniformGrid Columns="2">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Despesas fixas" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding DespesasFixas}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="10,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Empréstimos em aberto" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding Emprestimos}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,10,10,0">
                    <StackPanel>
                        <TextBlock Text="Débitos de devedores" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding DebitosDevedores}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="10,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Créditos de devedores" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding CreditosDevedores}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Background="{DynamicResource ElevatedSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Saldo do mês" Foreground="{DynamicResource MutedForegroundBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Saldo}" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Disponível no período" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
