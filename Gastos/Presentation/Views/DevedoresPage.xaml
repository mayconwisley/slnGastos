<UserControl x:Class="Gastos.Presentation.Views.DevedoresPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:Gastos.Presentation.Controles">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Cliente" /><ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Nome" /><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Descrição" /><TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Valor" /><TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Novo" Command="{Binding LimparCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" /><Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,0" /><Button Content="Excluir" Command="{Binding ExcluirCommand}" Background="{DynamicResource NegativeBrush}" /></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="130" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Data inicial" /><TextBox Text="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Parcelas" /><TextBox Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" /></StackPanel>
                <CheckBox Grid.Column="2" Content="Ativo" IsChecked="{Binding Ativo}" VerticalAlignment="Bottom" />
                <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
                <Button Grid.Column="4" Content="Gerar parcelas" Command="{Binding GerarParcelasCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <controles:DataGridArredondado ItemsSource="{Binding Devedores}" SelectedItem="{Binding DevedorSelecionado}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="180" />
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="120" />
                    <DataGridTextColumn Header="Parcelas" Binding="{Binding Parcelas}" Width="80" />
                    <DataGridTextColumn Header="Início" Binding="{Binding DataInicio, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    <DataGridCheckBoxColumn Header="Parcelas geradas" Binding="{Binding ParcelasGeradas}" Width="125" />
                </DataGrid.Columns>
            </controles:DataGridArredondado>
        </Border>
    </Grid>
</UserControl>
