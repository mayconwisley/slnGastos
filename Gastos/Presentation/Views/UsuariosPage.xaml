<UserControl x:Class="Gastos.Presentation.Views.UsuariosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Login" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LoginEditavel}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Nome" />
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Senha" />
                    <PasswordBox x:Name="Senha" PasswordChanged="SenhaAlterada" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Confirmar senha" />
                    <PasswordBox x:Name="ConfirmarSenha" PasswordChanged="ConfirmarSenhaAlterada" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,18,0,0">
                    <TextBlock Text="Lembrete" />
                    <TextBox Text="{Binding Lembrete, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
                    <CheckBox Content="Usuário ativo" IsChecked="{Binding Ativo}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,18,0,0">
                    <Button Content="Novo" Command="{Binding LimparCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,0" />
                    <Button Content="Excluir" Command="{Binding ExcluirCommand}" Background="{DynamicResource NegativeBrush}" />
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding Status}" Margin="0,14,0,0" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSelecionado}" SelectionMode="Single" SelectionChanged="AoSelecionarUsuario">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="160" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                    <DataGridTextColumn Header="Lembrete" Binding="{Binding Lembrete}" Width="*" />
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding EstaAtivo}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
